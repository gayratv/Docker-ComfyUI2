# Первая сборка (кэш записывается внутрь образа)
DOCKER_BUILDKIT=1 docker build \
  --build-arg BUILDKIT_INLINE_CACHE=1 \
  -t my-image:latest .

# Повторная сборка (используем образ в качестве источника кэша)
DOCKER_BUILDKIT=1 docker build \
  --build-arg BUILDKIT_INLINE_CACHE=1 \
  --cache-from=my-image:latest \
  -t my-image:latest .


